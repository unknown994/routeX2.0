{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch RouteX",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Node Server",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["http-server", "-p", "5500"],
            "port": 5500,
            "preLaunchTask": "npm: start"
        }
    ]
}